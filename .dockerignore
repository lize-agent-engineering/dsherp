.runtime
.venv
work
infra/env
infra/releases
frontend/node_modules
frontend/dist
evals/runs
docs
tests
.superpowers
.agents
.pytest_cache
.ruff_cache
**/__pycache__
*.py[cod]
*.log
.env
.env.*
.DS_Store
