# Build context for infra/docker/*/Dockerfile: only what the Dockerfiles COPY, never
# host state. Without this the daemon receives .runtime (credentials), filled
# environment files and the tooling trees.
.git
.runtime
.venv
work
infra/env
infra/releases
frontend/node_modules
frontend/dist
evals/runs
docs
tests
# 原生测试包是测试数据（权限矩阵与合成夹具），发布镜像不需要；应用目录本身仍然 COPY。
frappe_app/*/tests
.superpowers
.agents
.pytest_cache
.ruff_cache
**/__pycache__
*.py[cod]
*.log
.env
.env.*
.DS_Store
