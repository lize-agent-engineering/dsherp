{
  "doctype": "DocType",
  "name": "DS Model Run",
  "module": "DSHERP Bridge",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "hash",
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "domain",
    "conversation",
    "request_id",
    "request_digest",
    "question",
    "page_context",
    "status",
    "answer",
    "error",
    "sources",
    "cancel_request_id",
    "capability_hash",
    "expires_at",
    "queue_expires_at",
    "permission_revision",
    "runtime_revision",
    "model_calls",
    "model_input_bytes",
    "model_output_tokens_reserved",
    "needs_input",
    "provider_failures",
    "answer_flagged",
    "model",
    "provider_request_ids",
    "actual_input_tokens",
    "actual_output_tokens",
    "duration_ms",
    "skill_versions",
    "prompt_version",
    "sampling",
    "usage_unknown_calls"
  ],
  "fields": [
    {
      "fieldname": "domain",
      "label": "Domain",
      "fieldtype": "Select",
      "options": "query\noperation\nconfiguration",
      "default": "query",
      "reqd": 1
    },
    {
      "fieldname": "runtime_revision",
      "label": "Runtime revision",
      "fieldtype": "Data"
    },
    {
      "fieldname": "permission_revision",
      "label": "Permission revision",
      "fieldtype": "Data"
    },
    {
      "fieldname": "model_calls",
      "label": "Model calls",
      "fieldtype": "Int",
      "default": "0"
    },
    {
      "fieldname": "model_input_bytes",
      "label": "Model input bytes",
      "fieldtype": "Int",
      "default": "0"
    },
    {
      "fieldname": "model_output_tokens_reserved",
      "label": "Reserved output tokens",
      "fieldtype": "Int",
      "default": "0"
    },
    {
      "fieldname": "capability_hash",
      "label": "Capability hash",
      "fieldtype": "Data"
    },
    {
      "fieldname": "expires_at",
      "label": "Expires at",
      "fieldtype": "Datetime",
      "search_index": 1
    },
    {
      "fieldname": "queue_expires_at",
      "label": "Queue expires at",
      "fieldtype": "Datetime",
      "search_index": 1
    },
    {
      "fieldname": "needs_input",
      "label": "Needs input",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "provider_failures",
      "label": "Provider failures",
      "fieldtype": "Int",
      "default": "0"
    },
    {
      "fieldname": "answer_flagged",
      "label": "Answer flagged",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "conversation",
      "label": "conversation",
      "fieldtype": "Link",
      "options": "DS Conversation",
      "search_index": 1
    },
    {
      "fieldname": "request_id",
      "label": "request_id",
      "fieldtype": "Data"
    },
    {
      "fieldname": "request_digest",
      "label": "request_digest",
      "fieldtype": "Data"
    },
    {
      "fieldname": "question",
      "label": "question",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "page_context",
      "label": "page_context",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "status",
      "label": "status",
      "fieldtype": "Select",
      "options": "Queued\nRunning\nCancelling\nCancelled\nSucceeded\nFailed\nNeedsInput\nBudgetExceeded",
      "search_index": 1
    },
    {
      "fieldname": "answer",
      "label": "answer",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "error",
      "label": "error",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "sources",
      "label": "sources",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "cancel_request_id",
      "label": "cancel_request_id",
      "fieldtype": "Data"
    },
    {
      "fieldname": "model",
      "label": "Model actually used",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "provider_request_ids",
      "label": "Provider request ids",
      "fieldtype": "Long Text",
      "read_only": 1
    },
    {
      "fieldname": "actual_input_tokens",
      "label": "Input tokens the provider reported",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "actual_output_tokens",
      "label": "Output tokens the provider reported",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "duration_ms",
      "label": "Milliseconds from claim to finish",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "skill_versions",
      "label": "Skill versions this run loaded",
      "fieldtype": "Long Text",
      "read_only": 1
    },
    {
      "fieldname": "prompt_version",
      "label": "Prompt template version this run assembled",
      "fieldtype": "Data",
      "length": 40,
      "read_only": 1
    },
    {
      "fieldname": "sampling",
      "label": "Sampling actually sent to the provider",
      "fieldtype": "Data",
      "length": 40,
      "read_only": 1
    },
    {
      "fieldname": "usage_unknown_calls",
      "label": "Model calls whose usage the provider did not report",
      "fieldtype": "Int",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1
    }
  ]
}
