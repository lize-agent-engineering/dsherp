# Copy to infra/env/prod.env on the deployment host and fill in. Never commit the filled copy.
DSHERP_ENV=prod
# Compose project name; decides container, network and volume prefixes.
DSHERP_PROJECT=dsherp
# Wildcard base domain; every tenant Site is <slug>.<base domain> and platform is <platform slug>.<base domain>.
DSHERP_BASE_DOMAIN=tenant.example.com
DSHERP_PLATFORM_SLUG=platform
# Release tag; images are <registry>/dsherp-frappe:<tag> and <registry>/dsherp-worker:<tag>.
DSHERP_IMAGE_TAG=v0.0.0
DSHERP_IMAGE_REGISTRY=registry.example.com/dsherp
# Fixed non-root identity inside the Agent runtime container; must own the session directory.
DSHERP_AGENT_UID=1000
DSHERP_AGENT_GID=1000
# Address Caddy answers on; the ACME account e-mail for the wildcard certificate.
DSHERP_ACME_EMAIL=ops@example.com
# Server-to-server addresses inside the compose network; leave as-is unless services are renamed.
DSHERP_TENANT_INTERNAL_URL=http://backend:8000
DSHERP_PLATFORM_INTERNAL_URL=http://platform-backend:8000
# Where the tenant list, the rendered Caddyfile and the control-plane secrets live.
# Absolute, and set HERE rather than exported: compose reads this file for its ${...}
# interpolation and so does the CLI, which is the only way both can agree.
DSHERP_RUNTIME_DIR=/opt/dsherp/.runtime
DSHERP_SECRETS_DIR=/opt/dsherp/.runtime/control
