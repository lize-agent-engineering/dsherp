# Local synthetic four-Site stack. No secrets: control-plane passwords live in .runtime/control/.
DSHERP_ENV=dev
DSHERP_PROJECT=dsherp-validation
DSHERP_BASE_DOMAIN=localhost
DSHERP_PLATFORM_SLUG=dsherp-platform
# Development keeps the historical host ports instead of name-based routing.
DSHERP_ORIGINS=dsherp-validation=http://localhost:18082,dsherp-platform=http://platform.localhost:18083,dsherp-beta=http://preview.localhost:18085,dsherp-daily=http://daily.localhost:18086
# Empty means "the uid running the worker"; the agent container never runs as root.
DSHERP_AGENT_UID=
DSHERP_AGENT_GID=
